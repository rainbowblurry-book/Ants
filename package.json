{
  "name": "ants",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ANTS! Small ants. Big shots. A turn-based ant artillery game.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
